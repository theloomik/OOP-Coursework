    }
    QLabel#addModalTitle { color: #FFFFFF; font-size: 20px; font-weight: bold; }
    QLineEdit.modalField {
     background-color: #3A3A3A; color: #FFFFFF; border: none;
     border-radius: 10px; padding: 0 14px; font-size: 15px; min-height: 42px;
    }
    QLineEdit.modalField:focus { background-color: #202020; }
    QLineEdit.modalField::placeholder { color: #767676; }
    QLabel#errorLabel { color: #FF6B6B; font-size: 13px; }
    QPushButton#cancelAddBtn {
     background-color: #3A3A3A; color: #AAAAAA; border: none;
     border-radius: 10px; min-height: 42px; font-size: 15px;
    }
    QPushButton#saveAddBtn {
     background-color: #3A3A3A; color: #FFFFFF; border: 1.5px solid #4A7C59;
     border-radius: 10px; min-height: 42px; font-size: 15px; font-weight: 600;
    }
    QPushButton#cancelAddBtn:hover, QPushButton#saveAddBtn:hover { background-color: #505050; }
