    QTableWidget#clientsTable::item:hover { background-color: #333333; }
    QTableWidget#clientsTable::item:selected { background-color: #333333; color: #FFFFFF; }
    QHeaderView::section {
     background-color: transparent; color: #757575; border: none;
     font-size: 12px; font-weight: 600; padding: 0 10px 8px 10px;
    }
    QWidget#addOverlay { background-color: rgba(0, 0, 0, 165); }
