    QTableWidget { background-color: transparent; border: none; }
    QTableWidget::item { border-bottom: 1px solid #3E3E42; padding-left: 20px; }
    QTableWidget::item:hover { background-color: #333333; }
    QTableWidget::item:selected { background-color: #333333; color: #FFFFFF; }
    QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
    QScrollBar::handle:vertical { background: #555555; border-radius: 4px; min-height: 28px; }
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: transparent; }
    QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
    QComboBox { background-color: #3A3A3A; color: #FFFFFF; border: none; border-radius: 10px; min-height: 42px; padding: 0 12px; }
    QComboBox QAbstractItemView { background-color: #2B2B2B; color: #FFFFFF; selection-background-color: #3A3A3A; border: 1px solid #4A4A4A; }
