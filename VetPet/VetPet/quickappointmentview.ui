<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>QuickAppointmentView</class>
 <widget class="QWidget" name="QuickAppointmentView">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>960</width>
    <height>680</height>
   </rect>
  </property>
  <property name="styleSheet">
   <string>
    QWidget#QuickAppointmentView { background: transparent; }

    QLabel#titleLabel {
      color: white;
      font-size: 28px;
      font-weight: bold;
    }
    QLabel#subtitleLabel {
      color: #A7A7A7;
      font-size: 13px;
      margin-bottom: 8px;
    }

    QFrame#clientCard, QFrame#paramsCard, QFrame#bottomBar {
      background-color: #313131;
      border-radius: 12px;
      border: 1px solid #303030;
    }

    QLabel#clientCardTitle, QLabel#paramsCardTitle {
      color: white;
      font-size: 17px;
      font-weight: 600;
    }
    QLabel#phoneHeaderLabel, QLabel#petHeaderLabel,
    QLabel#staffHeaderLabel, QLabel#dateHeaderLabel,
    QLabel#serviceHeaderLabel, QLabel#statusHeaderLabel,
    QLabel#descriptionHeaderLabel {
      color: #8C8C8C;
      font-size: 12px;
      font-weight: 600;
    }
    QLabel#errorLabel  { color: #FF6B6B; font-size: 13px; }
    QLabel#hintLabel   { color: #B5B5B5; }

    QLineEdit#phoneEdit {
      background-color: #3A3A3A;
      color: white;
      border: none;
      border-radius: 10px;
      padding: 0px 14px 0px 38px;
      min-height: 44px;
    }

    QComboBox {
      background-color: #3A3A3A;
      color: white;
      border: 1px solid #343434;
      border-radius: 12px;
      min-height: 44px;
      padding: 0 12px;
    }
    QComboBox::drop-down  { border: none; width: 20px; }
    QComboBox::down-arrow { image: none; }
    QComboBox QAbstractItemView {
      background-color: #2B2B2B;
      color: white;
      selection-background-color: #3A3A3A;
      border: 1px solid #4A4A4A;
      outline: none;
    }

    QPushButton#addClientBtn, QPushButton#addPetBtn {
      background-color: transparent;
      border: 1px solid #4A4A4A;
      border-radius: 12px;
      color: #E8E8E8;
      min-height: 42px;
      text-align: left;
      padding: 0 14px;
    }
    QPushButton#addClientBtn:hover { background-color: #3A3A3A; }
    QPushButton#addPetBtn:hover    { background-color: #3A3A3A; }
    QPushButton#addPetBtn:disabled { color: #666666; border-color: #3A3A3A; }

    QPushButton#cancelBtn {
      background-color: #3A3A3A;
      border: none;
      border-radius: 12px;
      color: #C0C0C0;
      min-height: 44px;
      min-width: 140px;
      font-weight: 600;
    }
    QPushButton#cancelBtn:hover { background-color: #4A4A4A; }

    QPushButton#saveBtn {
      background-color: #3A3A3A;
      border: 1.5px solid #1b810d;
      border-radius: 12px;
      color: white;
      min-height: 48px;
      min-width: 180px;
      font-weight: 600;
    }
    QPushButton#saveBtn:hover { background-color: #454545; }

    QPlainTextEdit {
      background-color: #3A3A3A;
      color: white;
      border: none;
      border-radius: 10px;
      padding: 10px;
    }

    QScrollArea { background: transparent; border: none; }
    QScrollBar:vertical {
      background: transparent;
      width: 8px;
      margin: 0;
    }
    QScrollBar::handle:vertical {
      background: #555555;
      border-radius: 4px;
      min-height: 28px;
    }
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
    QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
   </string>
  </property>

  <layout class="QVBoxLayout" name="mainLayout">
   <property name="leftMargin"><number>30</number></property>
   <property name="topMargin"><number>25</number></property>
   <property name="rightMargin"><number>30</number></property>
   <property name="bottomMargin"><number>25</number></property>
   <property name="spacing"><number>0</number></property>

   <!-- Page title -->
   <item>
    <widget class="QLabel" name="titleLabel">
     <property name="text"><string>Швидкий запис</string></property>
    </widget>
   </item>

   <!-- Page subtitle -->
   <item>
    <widget class="QLabel" name="subtitleLabel">
     <property name="text"><string>Оформлення запису на прийом</string></property>
     <property name="margin"><number>6</number></property>
    </widget>
   </item>

   <!-- Scrollable content area -->
   <item>
    <widget class="QScrollArea" name="scrollArea">
     <property name="widgetResizable"><bool>true</bool></property>
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
     <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>

     <widget class="QWidget" name="scrollAreaWidgetContents">
      <property name="geometry">
       <rect><x>0</x><y>0</y><width>900</width><height>600</height></rect>
      </property>

      <layout class="QVBoxLayout" name="contentLayout">
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <property name="spacing"><number>16</number></property>

       <!-- Two-column card row -->
       <item>
        <layout class="QHBoxLayout" name="cardsLayout">
         <property name="spacing"><number>18</number></property>

         <!-- ===== LEFT CARD: Client & Pet ===== -->
         <item>
          <widget class="QFrame" name="clientCard">
           <layout class="QVBoxLayout" name="clientCardLayout">
            <property name="leftMargin"><number>22</number></property>
            <property name="topMargin"><number>22</number></property>
            <property name="rightMargin"><number>22</number></property>
            <property name="bottomMargin"><number>22</number></property>
            <property name="spacing"><number>10</number></property>

            <item>
             <widget class="QLabel" name="clientCardTitle">
              <property name="text"><string>Клієнт та тварина</string></property>
             </widget>
            </item>

            <!-- Phone search -->
            <item>
             <widget class="QLabel" name="phoneHeaderLabel">
              <property name="text"><string>Телефон клієнта *</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="phoneEdit">
              <property name="placeholderText"><string>Введіть телефон для пошуку</string></property>
              <property name="minimumHeight"><number>44</number></property>
             </widget>
            </item>

            <!-- Client matches combo -->
            <item>
             <widget class="QComboBox" name="clientCombo">
              <property name="minimumHeight"><number>44</number></property>
             </widget>
            </item>

            <!-- Add new client ghost button -->
            <item>
             <widget class="QPushButton" name="addClientBtn">
              <property name="text"><string>+ Створити нового клієнта</string></property>
              <property name="minimumHeight"><number>42</number></property>
             </widget>
            </item>

            <!-- Thin separator line -->
            <item>
             <widget class="QFrame" name="separatorLine">
              <property name="frameShape"><enum>QFrame::HLine</enum></property>
              <property name="frameShadow"><enum>QFrame::Plain</enum></property>
              <property name="styleSheet">
               <string>QFrame { color: rgba(255,255,255,20); }</string>
              </property>
             </widget>
            </item>

            <!-- Pet selection -->
            <item>
             <widget class="QLabel" name="petHeaderLabel">
              <property name="text"><string>Тварина *</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="petCombo">
              <property name="minimumHeight"><number>44</number></property>
             </widget>
            </item>

            <!-- Add new pet ghost button -->
            <item>
             <widget class="QPushButton" name="addPetBtn">
              <property name="text"><string>+ Створити нового улюбленця</string></property>
              <property name="minimumHeight"><number>42</number></property>
              <property name="enabled"><bool>false</bool></property>
             </widget>
            </item>

            <!-- Push cards to top -->
            <item>
             <spacer name="clientCardSpacer">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0">
               <size><width>20</width><height>40</height></size>
              </property>
             </spacer>
            </item>

           </layout>
          </widget>
         </item>

         <!-- ===== RIGHT CARD: Appointment parameters ===== -->
         <item>
          <widget class="QFrame" name="paramsCard">
           <layout class="QVBoxLayout" name="paramsCardLayout">
            <property name="leftMargin"><number>22</number></property>
            <property name="topMargin"><number>22</number></property>
            <property name="rightMargin"><number>22</number></property>
            <property name="bottomMargin"><number>22</number></property>
            <property name="spacing"><number>10</number></property>

            <item>
             <widget class="QLabel" name="paramsCardTitle">
              <property name="text"><string>Параметри запису</string></property>
             </widget>
            </item>

            <!-- Doctor (staff) -->
            <item>
             <widget class="QLabel" name="staffHeaderLabel">
              <property name="text"><string>Лікар *</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="staffCombo">
              <property name="minimumHeight"><number>44</number></property>
             </widget>
            </item>

            <!-- Date &amp; time pickers -->
            <item>
             <widget class="QLabel" name="dateHeaderLabel">
              <property name="text"><string>Дата та час *</string></property>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="dateTimeLayout">
              <property name="spacing"><number>8</number></property>
              <item>
               <widget class="QComboBox" name="dayCombo">
                <property name="minimumHeight"><number>44</number></property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="monthCombo">
                <property name="minimumHeight"><number>44</number></property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="yearCombo">
                <property name="minimumHeight"><number>44</number></property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="hourCombo">
                <property name="minimumHeight"><number>44</number></property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="minuteCombo">
                <property name="minimumHeight"><number>44</number></property>
               </widget>
              </item>
             </layout>
            </item>

            <!-- Service -->
            <item>
             <widget class="QLabel" name="serviceHeaderLabel">
              <property name="text"><string>Послуга</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="serviceCombo">
              <property name="minimumHeight"><number>44</number></property>
             </widget>
            </item>

            <!-- Status -->
            <item>
             <widget class="QLabel" name="statusHeaderLabel">
              <property name="text"><string>Статус</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="statusCombo">
              <property name="minimumHeight"><number>44</number></property>
              <item><property name="text"><string>заплановано</string></property></item>
              <item><property name="text"><string>виконано</string></property></item>
              <item><property name="text"><string>скасовано</string></property></item>
             </widget>
            </item>

            <!-- Description -->
            <item>
             <widget class="QLabel" name="descriptionHeaderLabel">
              <property name="text"><string>Примітка</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPlainTextEdit" name="descriptionEdit">
              <property name="placeholderText"><string>Короткий опис (необов'язково)</string></property>
              <property name="minimumHeight"><number>90</number></property>
              <property name="maximumHeight"><number>160</number></property>
             </widget>
            </item>

            <!-- Inline error message -->
            <item>
             <widget class="QLabel" name="errorLabel">
              <property name="text"><string></string></property>
              <property name="visible"><bool>false</bool></property>
              <property name="wordWrap"><bool>true</bool></property>
              <property name="alignment"><set>Qt::AlignHCenter|Qt::AlignVCenter</set></property>
             </widget>
            </item>

           </layout>
          </widget>
         </item>

        </layout>
       </item>

       <!-- ===== BOTTOM ACTION BAR ===== -->
       <item>
        <widget class="QFrame" name="bottomBar">
         <layout class="QHBoxLayout" name="bottomBarLayout">
          <property name="leftMargin"><number>22</number></property>
          <property name="topMargin"><number>16</number></property>
          <property name="rightMargin"><number>22</number></property>
          <property name="bottomMargin"><number>16</number></property>
          <property name="spacing"><number>12</number></property>

          <item>
           <widget class="QLabel" name="hintLabel">
            <property name="text"><string>Після збереження ви повернетесь на попередню сторінку.</string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
          <item>
           <spacer name="bottomBarSpacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0">
             <size><width>40</width><height>20</height></size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="cancelBtn">
            <property name="text"><string>Скасувати</string></property>
            <property name="minimumWidth"><number>140</number></property>
            <property name="minimumHeight"><number>44</number></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="saveBtn">
            <property name="text"><string>Підтвердити запис</string></property>
            <property name="minimumWidth"><number>180</number></property>
            <property name="minimumHeight"><number>48</number></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

      </layout>
     </widget>
    </widget>
   </item>

  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
