  <property name="styleSheet">
   <string>
    QLabel#titleLabel { color: #FFFFFF; font-size: 26px; font-weight: bold; margin-bottom: 20px; }
    QLabel.headerLabel { color: #757575; font-size: 12px; font-weight: 600; }
    QLineEdit#searchEdit, QLineEdit.modalField { background-color: #3A3A3A; color: #FFFFFF; border: none; border-radius: 10px; padding: 0 14px; min-height: 42px; font-size: 15px; }
    QLineEdit#searchEdit:focus, QLineEdit.modalField:focus { background-color: #202020; }
    QPushButton#sortBtn, QPushButton#newBtn { background-color: #3A3A3A; color: #FFFFFF; border: none; border-radius: 10px; font-weight: 600; font-size: 15px; min-height: 42px; }
    QPushButton#sortBtn:hover, QPushButton#newBtn:hover { background-color: #505050; }
    QTableWidget#staffTable { background-color: transparent; border: none; outline: none; }
    QTableWidget#staffTable::item { border-bottom: 1px solid rgba(255,255,255,13); }
    QTableWidget#staffTable::item:hover { background-color: #333333; }
    QWidget#addOverlay { background-color: rgba(0, 0, 0, 165); }
    QFrame#addModalCard { background-color: #2B2B2B; border: 1px solid #4A4A4A; border-radius: 14px; }
    QComboBox#positionCombo { background-color: #3A3A3A; color: white; border: none; border-radius: 10px; min-height: 42px; padding: 0 10px; }
    QPushButton#addPositionBtn { background-color: #3A3A3A; color: white; border: none; border-radius: 10px; font-size: 20px; }
    QPushButton.workDayBtn { background-color: #3A3A3A; color: white; border: 1px solid #3A3A3A; border-radius: 8px; min-width: 48px; max-width: 48px; min-height: 36px; }
    QPushButton.workDayBtn:checked { border: 2px solid #4A7C59; }
    QFrame#positionPanel { background-color: #333333; border-radius: 10px; }
    QPushButton#cancelAddBtn { background-color: #3A3A3A; color: #AAAAAA; border: none; border-radius: 10px; min-height: 42px; }
    QPushButton#saveAddBtn { background-color: #3A3A3A; color: white; border: 1.5px solid #4A7C59; border-radius: 10px; min-height: 42px; }
    QLabel#errorLabel, QLabel#positionErrorLabel { color: #FF6B6B; font-size: 13px; }
