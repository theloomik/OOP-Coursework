<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>StockView</class>
 <widget class="QWidget" name="StockView">
  <property name="styleSheet">
   <string>
    QLabel#titleLabel { color: #FFFFFF; font-size: 26px; font-weight: bold; margin-bottom: 16px; }
    QLabel.headerLabel, QPushButton.sortHeaderBtn { color: #757575; font-size: 12px; font-weight: 600; border: none; background: transparent; }
    QFrame.statCard { background-color: #2E2E2E; border-radius: 12px; padding: 10px 14px; }
    QLabel.statValue { color: white; font-size: 22px; font-weight: bold; }
    QLabel#lowStockValue { color: #FF8C8C; }
    QLineEdit#searchEdit, QLineEdit.modalField { background-color: #3A3A3A; color: #FFFFFF; border: none; border-radius: 10px; padding: 0 14px; min-height: 42px; font-size: 15px; }
    QLineEdit#searchEdit:focus, QLineEdit.modalField:focus { background-color: #202020; }
    QPushButton#newBtn { background-color: #3A3A3A; color: #FFFFFF; border: none; border-radius: 10px; min-width: 118px; min-height: 42px; }
    QTableWidget#stockTable { background-color: transparent; border: none; outline: none; color: white; }
    QTableWidget#stockTable::item { border-bottom: 1px solid rgba(255,255,255,13); padding: 6px 10px; }
    QTableWidget#stockTable::item:hover { background-color: #333333; }
    QTableWidget#stockTable::item:selected { background-color: #333333; color: #FFFFFF; }
    QWidget#addOverlay, QWidget#editOverlay { background-color: rgba(0, 0, 0, 165); }
    QFrame.modalCard { background-color: #2B2B2B; border: 1px solid #4A4A4A; border-radius: 14px; }
    QComboBox.modalCombo { background-color: #3A3A3A; color: white; border: none; border-radius: 10px; min-height: 42px; }
    QPushButton#cancelAddBtn, QPushButton#cancelEditBtn { background-color: #3A3A3A; color: #D0D0D0; border: none; border-radius: 12px; min-height: 44px; }
    QPushButton#saveAddBtn, QPushButton#saveEditBtn { background-color: #2ECC71; color: white; border: 1px solid #76E2A0; border-radius: 12px; min-height: 44px; font-weight: bold; }
    QPushButton#deleteEditBtn { background-color: #7C4A4A; color: white; border: none; border-radius: 12px; min-height: 44px; }
    QLabel#errorLabel, QLabel#editErrorLabel { color: #FF6B6B; }
   </string>
